return {
  "kndndrj/nvim-dbee",
  dependencies = { "MunifTanjim/nui.nvim" },
  build = function() require("dbee").install() end,
  config = function()
    local source = require "dbee.sources"
    require("dbee").setup {
      sources = {
        source.MemorySource:new {
          { name = "dev_db", type = "postgres", url = "postgresql://..." },
        },
      },
    }
  end,
  vim.keymap.set("n", "<leader>db", function() require("dbee").toggle() end),
  vim.keymap.set("n", "<leader>de", function() require("dbee").execute() end),
}
