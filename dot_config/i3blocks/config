# Guess the weather hourly
[weather]
#command=curl -Ss 'https://wttr.in?0&T&Q' | cut -c 16- | head -2 | xargs echo

command=curl -Ss "https://wttr.in/Zürich?0&T&Q" | cut -c 16- | head -2 | xargs echo
interval=3600
color=#A4C2F4

# Query my default IP address only on startup
[ip]
command=hostname -i | awk '{ print "IP:" $1 }'
interval=once
color=#ff2222

# Update time every 5 seconds
[time]
command=date +'%d.%m.-%T'
interval=5
color=#f9e2af

[wlan]
command=/home/david/.config/i3blocks/wlan-status.sh
interval=5
markup=pango

[reverse-thetering]
command=/home/david/.config/i3blocks/reverse-thetering.sh
interval=10
#color=#ff2222
markup=pango

[battery]
command=/home/david/.config/i3blocks/battery.sh
interval=30
#color=#ff2222
markup=pango

[Sapphire]
full_text="Sapphire"
color=#ff2222

[Blue]
full_text="Blue"
color=#89b4fa


